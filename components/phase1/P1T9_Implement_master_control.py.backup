#!/usr/bin/env python3
"""
P1T9_Implement_master_control.py
Master Control Protocol - Adaptive Multi-Factor Authentication
With full TouchID support for MacBooks and device trust levels
"""

import os
import sys
import json
import time
import logging
import traceback
import hashlib
import hmac
import base64
import pickle
import platform
import subprocess
from pathlib import Path
from datetime import datetime, timedelta
from typing import Dict, List, Any, Optional, Tuple
from enum import Enum

# Configure logging
logging.basicConfig(
    level=logging.INFO,
    format='%(asctime)s - 🧠 DMAI[%(name)s] - %(levelname)s - %(message)s',
    handlers=[
        logging.FileHandler('master_control.log'),
        logging.StreamHandler()
    ]
)
logger = logging.getLogger('MasterControl')

class AuthLevel(Enum):
    """Authentication levels"""
    NONE = 0          # Not authenticated
    VOICE_ONLY = 1    # Voice-only limited access
    BASIC = 2         # Device + 1 factor
    STANDARD = 3      # Device + 2 factors
    HIGH = 4          # Device + all factors
    MASTER = 5        # Full master access
    EMERGENCY = 6     # Emergency override

class DeviceTrustLevel(Enum):
    """Device trust levels"""
    UNKNOWN = 0       # Never seen before
    LOW = 1           # New device, limited trust
    MEDIUM = 2        # Verified device, regular use
    HIGH = 3          # Trusted personal device
    MASTER = 4        # Master device (your primary)

class ActionRisk(Enum):
    """Risk level of actions"""
    VIEW = 0          # Viewing status, no changes
    COMMAND = 1       # Regular commands
    RECOVER = 2       # Recovery operations
    CONTROL = 3       # Engine control
    SHUTDOWN = 4      # Shutdown operations
    TERMINATE = 5     # Permanent termination

class MasterControl:
    """
    Master Control Protocol - Adaptive Multi-Factor Authentication
    Provides progressive security based on device trust and action risk
    With full TouchID support for MacBooks
    """
    
    def __init__(self):
        self.name = "Master Control"
        self.component_id = "P1T9"
        self.version = "3.1.0"  # Updated with TouchID support
        self.status = "initialized"
        self.depends_on = ["P1T1", "P1T2", "P1T3", "P1T4", "P1T5", "P1T6", "P1T7", "P1T8"]
        
        # Storage paths
        self.config_dir = Path.home() / ".dmai"
        self.config_dir.mkdir(parents=True, exist_ok=True)
        
        # Load all configurations
        self.biometric_data = self._load_json('biometrics.json', {})
        self.trusted_devices = self._load_json('trusted_devices.json', {})
        self.user_preferences = self._load_json('preferences.json', self._default_preferences())
        self.auth_sessions = self._load_json('sessions.json', {})
        
        # Current device info
        self.current_device = self._get_device_info()
        
        # Recovery engines
        self.recovery_engines = {
            'engine1': {
                'name': 'Recovery Engine #1',
                'status': 'standby',
                'last_contact': datetime.now().isoformat()
            },
            'engine2': {
                'name': 'Recovery Engine #2',
                'status': 'standby',
                'last_contact': datetime.now().isoformat()
            }
        }
        
        # Authentication state
        self.auth_state = {
            'level': AuthLevel.NONE.value,
            'verified_factors': [],
            'master_token': None,
            'session_id': None,
            'authenticated_at': None,
            'expires_at': None,
            'device_id': self.current_device['id'],
            'failed_attempts': 0,
            'locked_until': None
        }
        
        # Statistics
        self.stats = {
            'total_authentications': 0,
            'successful_authentications': 0,
            'failed_authentications': 0,
            'commands_issued': 0,
            'devices_registered': len(self.trusted_devices),
            'last_command': None
        }
        
        self._log_status()
    
    # ======================================================================
    # TOUCHID METHODS - REAL FINGERPRINT FOR MAC
    # ======================================================================
    
    def _verify_touchid(self, reason: str = "DMAI Master Control Authentication") -> bool:
        """
        Verify using Mac TouchID
        This uses Apple's official LocalAuthentication framework
        """
        if platform.system() != "Darwin":
            logger.debug("Not on macOS, TouchID unavailable")
            return False
        
        try:
            # Import macOS-specific frameworks
            import sys
            sys.path.append('/System/Library/PrivateFrameworks')
            
            # Try to import LocalAuthentication
            try:
                from LocalAuthentication import LAContext
            except ImportError:
                logger.warning("⚠️ LocalAuthentication framework not available")
                return False
            
            import threading
            
            context = LAContext.alloc().init()
            context.setLocalizedReason_(reason)
            
            # Check if TouchID is available
            error = None
            if not context.canEvaluatePolicy_error_(1, error):
                logger.warning("⚠️ TouchID not available on this system")
                return False
            
            # Create semaphore for async operation
            semaphore = threading.Semaphore(0)
            result = [False]
            
            def callback(success, error):
                result[0] = success
                semaphore.release()
            
            # Evaluate TouchID
            context.evaluatePolicy_localizedReason_reply_(
                1,  # LAPolicyDeviceOwnerAuthenticationWithBiometrics
                reason,
                callback
            )
            
            # Wait for result with timeout
            if semaphore.acquire(timeout=30):
                if result[0]:
                    logger.info("✅ TouchID verified successfully")
                    return True
                else:
                    logger.warning("❌ TouchID verification failed")
                    return False
            else:
                logger.warning("⏱️ TouchID authentication timed out")
                return False
                
        except ImportError:
            logger.warning("⚠️ Could not import LocalAuthentication framework")
            return False
        except Exception as e:
            logger.error(f"❌ TouchID error: {e}")
            return False
    
    def _check_touchid_status(self) -> Dict[str, Any]:
        """Check TouchID status safely using bioutil"""
        if platform.system() != "Darwin":
            return {'available': False, 'reason': 'Not macOS'}
        
        try:
            # Use bioutil to check status (safe read-only)
            result = subprocess.run(['bioutil', '-r'], capture_output=True, text=True)
            
            if result.returncode == 0:
                lines = result.stdout.strip().split('\n')
                status = {
                    'available': True,
                    'for_unlock': False,
                    'for_applepay': False,
                    'effective_unlock': False,
                    'effective_applepay': False
                }
                
                for line in lines:
                    if 'Biometrics for unlock: 1' in line:
                        status['for_unlock'] = True
                    if 'Biometrics for ApplePay: 1' in line:
                        status['for_applepay'] = True
                    if 'Effective biometrics for unlock: 1' in line:
                        status['effective_unlock'] = True
                    if 'Effective biometrics for ApplePay: 1' in line:
                        status['effective_applepay'] = True
                
                return status
        except Exception as e:
            logger.error(f"Error checking TouchID status: {e}")
        
        return {'available': False}
    
    def enroll_touchid(self) -> Dict[str, Any]:
        """Enroll TouchID for master control"""
        logger.info("📝 Enrolling TouchID")
        
        if platform.system() != "Darwin":
            return {
                'status': 'failed',
                'message': 'TouchID is only available on macOS'
            }
        
        # Check TouchID status
        status = self._check_touchid_status()
        
        if not status.get('available', False):
            return {
                'status': 'failed',
                'message': 'TouchID not available or not configured',
                'details': 'Please set up TouchID in System Settings first'
            }
        
        print("\n🖐️ TOUCHID ENROLLMENT")
        print(f"   • For unlock: {'✅' if status.get('for_unlock') else '❌'}")
        print(f"   • For ApplePay: {'✅' if status.get('for_applepay') else '❌'}")
        print(f"   • Effective for unlock: {'✅' if status.get('effective_unlock') else '❌'}")
        
        print("\nWe'll now test TouchID verification.")
        print("You'll see the standard TouchID prompt.")
        
        # Test TouchID
        if self._verify_touchid("Enroll TouchID for DMAI Master Control"):
            # Store TouchID configuration
            bio_entry = {
                'type': 'touchid',
                'enrolled_at': datetime.now().isoformat(),
                'device_id': self.current_device['id'],
                'method': 'touchid',
                'status': status,
                'device_name': self.current_device['name']
            }
            
            if 'master' not in self.biometric_data:
                self.biometric_data['master'] = {}
            self.biometric_data['master']['touchid'] = bio_entry
            self._save_json('biometrics.json', self.biometric_data)
            
            logger.info("✅ TouchID enrolled successfully")
            
            return {
                'status': 'enrolled',
                'method': 'touchid',
                'message': '✅ TouchID enrolled successfully for master control'
            }
        else:
            return {
                'status': 'failed',
                'message': '❌ TouchID verification failed',
                'suggestion': 'Try re-adding your fingerprint in System Settings'
            }
    
    # ======================================================================
    # PUBLIC AUTHENTICATION METHODS
    # ======================================================================
    
    def authenticate(self, context: Dict[str, Any]) -> Dict[str, Any]:
        """
        Adaptive authentication based on context
        
        Context contains:
        - device_id: Device identifier
        - input_methods: Available input methods ['keyboard', 'touch', 'camera', 'voice']
        - action: Action being attempted
        - factors: Provided authentication factors
        """
        device_id = context.get('device_id', self.current_device['id'])
        action = context.get('action', 'view')
        provided_factors = context.get('factors', {})
        
        # Get device info
        device = self._get_device(device_id)
        
        # Calculate required factors
        required = self._calculate_required_factors(device, action)
        
        # Verify provided factors
        verification = self._verify_factors(provided_factors, required)
        
        # Update device trust if successful
        if verification['success']:
            self._update_device_trust(device_id, verification['factors_verified'])
            self._create_session(device_id, verification['level'])
            
            logger.info(f"✅ Authentication successful - Level: {verification['level']}")
        else:
            self._handle_failed_attempt(device_id)
            logger.warning(f"❌ Authentication failed - Required: {required['required']}, Got: {len(provided_factors)}")
        
        return verification
    
    def quick_auth(self, action: str = "view") -> Dict[str, Any]:
        """
        Quick authentication for trusted devices
        Uses device recognition + stored session
        """
        device = self._get_device(self.current_device['id'])
        
        # Check for existing valid session
        if self._has_valid_session(self.current_device['id']):
            return {
                'status': 'authenticated',
                'level': AuthLevel.STANDARD.value,
                'message': 'Session valid',
                'device_trust': device['trust_level']
            }
        
        # For trusted devices, require fewer factors
        required_factors = {
            'master': 0,
            'high': 1,
            'medium': 2,
            'low': 3,
            'unknown': 3
        }.get(device.get('trust_level', 'unknown'), 3)
        
        return {
            'status': 'factors_required',
            'required_factors': required_factors,
            'device_trust': device.get('trust_level', 'unknown'),
            'available_methods': self._get_available_methods(device)
        }
    
    def register_device(self, device_name: str = None, trust_level: str = 'medium') -> Dict[str, Any]:
        """
        Register a new device
        """
        device_id = self.current_device['id']
        
        if device_id in self.trusted_devices:
            return {'status': 'already_registered', 'device_id': device_id}
        
        device_info = {
            'id': device_id,
            'name': device_name or self.current_device['name'],
            'trust_level': trust_level,
            'first_seen': datetime.now().isoformat(),
            'last_seen': datetime.now().isoformat(),
            'auth_count': 0,
            'factors_used': [],
            'capabilities': self.current_device['capabilities']
        }
        
        self.trusted_devices[device_id] = device_info
        self._save_json('trusted_devices.json', self.trusted_devices)
        self.stats['devices_registered'] = len(self.trusted_devices)
        
        logger.info(f"✅ Device registered: {device_info['name']} ({trust_level} trust)")
        
        return {
            'status': 'registered',
            'device': device_info,
            'message': f"Device registered with {trust_level} trust level"
        }
    
    def enroll_biometric(self, bio_type: str, bio_data: Any, label: str = "master") -> Dict[str, Any]:
        """
        Enroll a biometric factor
        """
        logger.info(f"📝 Enrolling {bio_type}")
        
        # Create biometric entry
        bio_entry = {
            'type': bio_type,
            'label': label,
            'enrolled_at': datetime.now().isoformat(),
            'data': self._hash_biometric(bio_data) if bio_type != 'touchid' else None,
            'device_id': self.current_device['id'],
            'metadata': {
                'quality': 'high',
                'version': self.version
            }
        }
        
        # Store
        if label not in self.biometric_data:
            self.biometric_data[label] = {}
        self.biometric_data[label][bio_type] = bio_entry
        
        self._save_json('biometrics.json', self.biometric_data)
        
        logger.info(f"✅ {bio_type} enrolled successfully")
        
        return {
            'status': 'enrolled',
            'type': bio_type,
            'label': label,
            'enrolled_at': bio_entry['enrolled_at']
        }
    
    def verify_master_access(self, factors: Dict[str, Any]) -> Dict[str, Any]:
        """
        Full master authentication - requires all factors
        """
        # Check lockout
        if self.auth_state['locked_until']:
            if datetime.now().timestamp() < self.auth_state['locked_until']:
                remaining = int(self.auth_state['locked_until'] - datetime.now().timestamp())
                return {
                    'status': 'locked',
                    'message': f"Too many failed attempts. Locked for {remaining} seconds",
                    'locked_until': datetime.fromtimestamp(self.auth_state['locked_until']).isoformat()
                }
            else:
                self.auth_state['locked_until'] = None
                self.auth_state['failed_attempts'] = 0
        
        # Verify each factor
        crypto_ok = self._verify_crypto(factors.get('crypto_key'))
        pattern_ok = self._verify_pattern(factors.get('pattern'))
        face_ok = self._verify_face(factors.get('face'))
        
        # Handle TouchID specially
        fingerprint_ok = False
        if factors.get('use_touchid'):
            fingerprint_ok = self._verify_touchid("Master Access Verification")
        else:
            fingerprint_ok = self._verify_fingerprint(factors.get('fingerprint'))
        
        voice_ok = self._verify_voice(factors.get('voice'))
        
        # Count verified factors
        verified = []
        if crypto_ok: verified.append('crypto')
        if pattern_ok: verified.append('pattern')
        if face_ok: verified.append('face')
        if fingerprint_ok: verified.append('fingerprint')
        if voice_ok: verified.append('voice')
        
        self.stats['total_authentications'] += 1
        
        # Master access requires at least 3 factors including crypto+pattern
        if crypto_ok and pattern_ok and len(verified) >= 3:
            self.auth_state['level'] = AuthLevel.MASTER.value
            self.auth_state['verified_factors'] = verified
            self.auth_state['authenticated_at'] = datetime.now().isoformat()
            self.auth_state['failed_attempts'] = 0
            self.auth_state['device_id'] = self.current_device['id']
            
            # Generate session token
            token_data = f"{verified}{time.time()}{self.current_device['id']}"
            self.auth_state['master_token'] = hashlib.sha512(token_data.encode()).hexdigest()
            self.auth_state['session_id'] = hashlib.md5(f"{time.time()}".encode()).hexdigest()[:16]
            self.auth_state['expires_at'] = (datetime.now() + timedelta(hours=24)).isoformat()
            
            self.stats['successful_authentications'] += 1
            
            # Update device trust
            self._update_device_trust(self.current_device['id'], verified)
            
            logger.warning("✅ MASTER ACCESS GRANTED")
            
            return {
                'status': 'authenticated',
                'level': AuthLevel.MASTER.value,
                'verified_factors': verified,
                'master_token': self.auth_state['master_token'],
                'session_id': self.auth_state['session_id'],
                'expires_at': self.auth_state['expires_at'],
                'message': '✅ Master access granted'
            }
        else:
            self.auth_state['failed_attempts'] += 1
            self.stats['failed_authentications'] += 1
            
            # Lockout after 5 failures
            if self.auth_state['failed_attempts'] >= 5:
                self.auth_state['locked_until'] = datetime.now().timestamp() + 300
                logger.warning(f"🔒 Too many failures - locked for 5 minutes")
            
            return {
                'status': 'failed',
                'message': '❌ Master access denied',
                'verified_factors': verified,
                'required': ['crypto', 'pattern', 'at least one biometric'],
                'failed_attempts': self.auth_state['failed_attempts'],
                'max_attempts': 5
            }
    
    # ======================================================================
    # COMMAND EXECUTION
    # ======================================================================
    
    def execute_command(self, command: str, auth_token: str = None, params: Dict = None) -> Dict[str, Any]:
        """
        Execute a command with appropriate authentication
        """
        # Check session
        if not self._verify_session(auth_token):
            return {
                'status': 'unauthorized',
                'message': '❌ Invalid or expired session',
                'command': command
            }
        
        # Check command risk
        risk = self._get_command_risk(command)
        required_level = self._risk_to_level(risk)
        
        if self.auth_state['level'] < required_level:
            return {
                'status': 'insufficient_level',
                'message': f'❌ Need level {required_level}, have {self.auth_state["level"]}',
                'command': command
            }
        
        # Execute command
        result = self._execute_command(command, params)
        
        self.stats['commands_issued'] += 1
        self.stats['last_command'] = datetime.now().isoformat()
        
        return result
    
    # ======================================================================
    # PRIVATE VERIFICATION METHODS
    # ======================================================================
    
    def _verify_crypto(self, key: str) -> bool:
        """Verify cryptographic key"""
        if not key:
            return False
        
        master = self.biometric_data.get('master', {}).get('crypto', {})
        if not master:
            # Default for testing - will be replaced on enrollment
            return key == "DMAI-MASTER-KEY-2026"
        
        key_hash = hashlib.sha512(key.encode()).hexdigest()
        return hmac.compare_digest(key_hash, master.get('hash', ''))
    
    def _verify_pattern(self, pattern: Any) -> bool:
        """Verify secret pattern"""
        if not pattern:
            return False
        
        master = self.biometric_data.get('master', {}).get('pattern', {})
        if not master:
            # Default for testing
            return str(pattern) == "DMAI-PATTERN-2026"
        
        pattern_hash = hashlib.sha512(str(pattern).encode()).hexdigest()
        return hmac.compare_digest(pattern_hash, master.get('hash', ''))
    
    def _verify_face(self, face_data: Any) -> bool:
        """Verify face recognition"""
        if not face_data:
            return False
        
        master = self.biometric_data.get('master', {}).get('face', {})
        if not master:
            return False
        
        # Compare face hashes
        face_hash = self._hash_biometric(face_data)
        return hmac.compare_digest(face_hash, master.get('data', ''))
    
    def _verify_fingerprint(self, fingerprint: Any) -> bool:
        """Verify fingerprint (PIN fallback)"""
        if not fingerprint:
            return False
        
        master = self.biometric_data.get('master', {}).get('fingerprint_pin', {})
        if not master:
            return False
        
        fp_hash = hashlib.sha256(str(fingerprint).encode()).hexdigest()
        return hmac.compare_digest(fp_hash, master.get('hash', ''))
    
    def _verify_voice(self, voice_sample: Any) -> bool:
        """Verify voice sample"""
        if not voice_sample:
            return False
        
        master = self.biometric_data.get('master', {}).get('voice', {})
        if not master:
            return False
        
        voice_hash = self._hash_biometric(voice_sample)
        return hmac.compare_digest(voice_hash, master.get('data', ''))
    
    # ======================================================================
    # DEVICE MANAGEMENT
    # ======================================================================
    
    def _get_device_info(self) -> Dict[str, Any]:
        """Get current device information"""
        hostname = platform.node()
        system = platform.system()
        machine = platform.machine()
        
        # Generate unique device ID
        device_id = hashlib.md5(f"{hostname}{system}{machine}".encode()).hexdigest()[:16]
        
        # Determine capabilities
        capabilities = ['keyboard']
        if system == 'Darwin':
            capabilities.extend(['touch', 'camera', 'touchid'])
        elif system == 'Linux':
            capabilities.extend(['touch', 'camera'])
        
        return {
            'id': device_id,
            'name': hostname,
            'system': system,
            'machine': machine,
            'capabilities': capabilities,
            'first_seen': datetime.now().isoformat()
        }
    
    def _get_device(self, device_id: str) -> Dict[str, Any]:
        """Get device info, create if doesn't exist"""
        if device_id in self.trusted_devices:
            device = self.trusted_devices[device_id]
            device['last_seen'] = datetime.now().isoformat()
            return device
        
        # New device
        return {
            'id': device_id,
            'name': self.current_device['name'],
            'trust_level': 'unknown',
            'first_seen': datetime.now().isoformat(),
            'last_seen': datetime.now().isoformat(),
            'auth_count': 0,
            'factors_used': [],
            'capabilities': self.current_device['capabilities']
        }
    
    def _update_device_trust(self, device_id: str, verified_factors: List[str]):
        """Update device trust level based on successful auth"""
        if device_id not in self.trusted_devices:
            return
        
        device = self.trusted_devices[device_id]
        device['auth_count'] = device.get('auth_count', 0) + 1
        device['last_seen'] = datetime.now().isoformat()
        
        # Add new factors to device's used list
        current_factors = set(device.get('factors_used', []))
        current_factors.update(verified_factors)
        device['factors_used'] = list(current_factors)
        
        # Upgrade trust level based on auth count and factors
        if device['auth_count'] > 50 and len(current_factors) >= 3:
            device['trust_level'] = 'master'
        elif device['auth_count'] > 20 and len(current_factors) >= 2:
            device['trust_level'] = 'high'
        elif device['auth_count'] > 5:
            device['trust_level'] = 'medium'
        
        self._save_json('trusted_devices.json', self.trusted_devices)
    
    # ======================================================================
    # SESSION MANAGEMENT
    # ======================================================================
    
    def _create_session(self, device_id: str, level: int):
        """Create a new session"""
        session_id = hashlib.md5(f"{device_id}{time.time()}".encode()).hexdigest()[:16]
        
        session = {
            'device_id': device_id,
            'level': level,
            'created_at': datetime.now().isoformat(),
            'expires_at': (datetime.now() + timedelta(hours=1)).isoformat(),
            'last_used': datetime.now().isoformat()
        }
        
        self.auth_sessions[session_id] = session
        self._save_json('sessions.json', self.auth_sessions)
        
        self.auth_state['session_id'] = session_id
        self.auth_state['expires_at'] = session['expires_at']
    
    def _verify_session(self, token: str) -> bool:
        """Verify session token"""
        if not token:
            return False
        
        if token != self.auth_state['master_token']:
            return False
        
        if not self.auth_state['expires_at']:
            return False
        
        expiry = datetime.fromisoformat(self.auth_state['expires_at'])
        if datetime.now() > expiry:
            return False
        
        return True
    
    def _has_valid_session(self, device_id: str) -> bool:
        """Check if device has valid session"""
        for session in self.auth_sessions.values():
            if session['device_id'] == device_id:
                expiry = datetime.fromisoformat(session['expires_at'])
                if datetime.now() < expiry:
                    return True
        return False
    
    # ======================================================================
    # RISK AND REQUIREMENT CALCULATION
    # ======================================================================
    
    def _calculate_required_factors(self, device: Dict[str, Any], action: str) -> Dict[str, Any]:
        """Calculate required authentication factors based on context"""
        
        # Base requirements by device trust
        trust_requirements = {
            'master': {'min_factors': 0, 'need_crypto': False, 'need_pattern': False},
            'high': {'min_factors': 1, 'need_crypto': False, 'need_pattern': False},
            'medium': {'min_factors': 2, 'need_crypto': False, 'need_pattern': False},
            'low': {'min_factors': 2, 'need_crypto': True, 'need_pattern': False},
            'unknown': {'min_factors': 3, 'need_crypto': True, 'need_pattern': True}
        }
        
        # Risk modifiers by action
        risk_modifiers = {
            'view': {'additional_factors': 0, 'need_crypto': False},
            'status': {'additional_factors': 0, 'need_crypto': False},
            'command': {'additional_factors': 0, 'need_crypto': False},
            'recover': {'additional_factors': 1, 'need_crypto': True},
            'control': {'additional_factors': 1, 'need_crypto': True},
            'shutdown': {'additional_factors': 2, 'need_crypto': True},
            'terminate': {'additional_factors': 2, 'need_crypto': True}
        }
        
        trust_level = device.get('trust_level', 'unknown')
        base = trust_requirements.get(trust_level, trust_requirements['unknown'])
        risk = risk_modifiers.get(action, risk_modifiers['view'])
        
        return {
            'required': base['min_factors'] + risk['additional_factors'],
            'need_crypto': base['need_crypto'] or risk['need_crypto'],
            'need_pattern': base['need_pattern'],
            'device_trust': trust_level,
            'action_risk': action
        }
    
    def _verify_factors(self, provided: Dict[str, Any], required: Dict[str, Any]) -> Dict[str, Any]:
        """Verify provided factors against requirements"""
        verified = []
        
        # Check each factor
        if required['need_crypto'] and self._verify_crypto(provided.get('crypto')):
            verified.append('crypto')
        
        if required['need_pattern'] and self._verify_pattern(provided.get('pattern')):
            verified.append('pattern')
        
        # Check for TouchID first (if available)
        if provided.get('use_touchid'):
            if self._verify_touchid("Authentication Required"):
                verified.append('touchid')
        else:
            # Biometric factors
            if self._verify_face(provided.get('face')):
                verified.append('face')
            
            if self._verify_fingerprint(provided.get('fingerprint')):
                verified.append('fingerprint')
            
            if self._verify_voice(provided.get('voice')):
                verified.append('voice')
        
        # Determine auth level
        level = AuthLevel.NONE.value
        success = False
        
        if len(verified) >= required['required']:
            if required['need_crypto'] and 'crypto' not in verified:
                success = False
            elif required['need_pattern'] and 'pattern' not in verified:
                success = False
            else:
                success = True
                
                if len(verified) >= 4:
                    level = AuthLevel.MASTER.value
                elif len(verified) >= 3:
                    level = AuthLevel.HIGH.value
                elif len(verified) >= 2:
                    level = AuthLevel.STANDARD.value
                else:
                    level = AuthLevel.BASIC.value
        
        return {
            'success': success,
            'level': level,
            'factors_verified': verified,
            'factors_required': required['required'],
            'need_crypto': required['need_crypto'],
            'need_pattern': required['need_pattern']
        }
    
    def _get_command_risk(self, command: str) -> str:
        """Get risk level for a command"""
        risk_map = {
            'status': 'view',
            'list': 'view',
            'info': 'view',
            'recover': 'recover',
            'sync': 'command',
            'freeze': 'control',
            'shutdown': 'shutdown',
            'terminate': 'terminate'
        }
        return risk_map.get(command, 'command')
    
    def _risk_to_level(self, risk: str) -> int:
        """Convert risk to required auth level"""
        level_map = {
            'view': AuthLevel.BASIC.value,
            'command': AuthLevel.STANDARD.value,
            'recover': AuthLevel.HIGH.value,
            'control': AuthLevel.HIGH.value,
            'shutdown': AuthLevel.MASTER.value,
            'terminate': AuthLevel.MASTER.value
        }
        return level_map.get(risk, AuthLevel.STANDARD.value)
    
    # ======================================================================
    # COMMAND EXECUTION
    # ======================================================================
    
    def _execute_command(self, command: str, params: Dict) -> Dict[str, Any]:
        """Execute a command"""
        if command == 'status':
            return {'status': 'ok', 'engines': self.recovery_engines}
        elif command == 'recover':
            for engine in self.recovery_engines:
                self.recovery_engines[engine]['status'] = 'recovering'
            return {'status': 'recovering', 'message': 'Recovery initiated'}
        elif command == 'freeze':
            for engine in self.recovery_engines:
                self.recovery_engines[engine]['status'] = 'frozen'
            return {'status': 'frozen', 'message': 'Engines frozen'}
        elif command == 'shutdown':
            return {'status': 'shutdown', 'message': 'Shutdown initiated'}
        else:
            return {'status': 'unknown', 'message': f'Unknown command: {command}'}
    
    # ======================================================================
    # UTILITY METHODS
    # ======================================================================
    
    def _get_available_methods(self, device: Dict[str, Any]) -> List[str]:
        """Get available authentication methods for device"""
        methods = []
        capabilities = device.get('capabilities', [])
        
        if 'keyboard' in capabilities:
            methods.extend(['crypto', 'pattern'])
        if 'camera' in capabilities:
            methods.append('face')
        if 'touchid' in capabilities:
            methods.append('touchid')
        if 'touch' in capabilities:
            methods.append('fingerprint')
        if 'microphone' in capabilities:
            methods.append('voice')
        
        return methods
    
    def _handle_failed_attempt(self, device_id: str):
        """Handle failed authentication attempt"""
        if device_id in self.trusted_devices:
            # Demote device trust on repeated failures
            device = self.trusted_devices[device_id]
            if device['trust_level'] == 'high':
                device['trust_level'] = 'medium'
            elif device['trust_level'] == 'medium':
                device['trust_level'] = 'low'
    
    def _hash_biometric(self, data: Any) -> str:
        """Create secure hash of biometric data"""
        if isinstance(data, (dict, list)):
            str_data = json.dumps(data, sort_keys=True)
        else:
            str_data = str(data)
        
        salt = hashlib.sha256(b"DMAI_BIOMETRIC_SALT_v1").hexdigest()
        return hashlib.sha512(f"{str_data}{salt}".encode()).hexdigest()
    
    def _load_json(self, filename: str, default: Any) -> Any:
        """Load JSON from config directory"""
        path = self.config_dir / filename
        if path.exists():
            try:
                with open(path, 'r') as f:
                    return json.load(f)
            except:
                logger.warning(f"⚠️ Could not load {filename}")
        return default
    
    def _save_json(self, filename: str, data: Any):
        """Save JSON to config directory"""
        path = self.config_dir / filename
        with open(path, 'w') as f:
            json.dump(data, f, indent=2)
        os.chmod(path, 0o600)
    
    def _default_preferences(self) -> Dict[str, Any]:
        """Default user preferences"""
        return {
            'session_timeout': 3600,  # 1 hour
            'master_timeout': 86400,   # 24 hours
            'max_failures': 5,
            'lockout_duration': 300,    # 5 minutes
            'trusted_device_threshold': 10,
            'voice_confidence_threshold': 0.8,
            'face_confidence_threshold': 0.9,
            'auto_register_devices': True,
            'notify_on_new_device': True
        }
    
    def _log_status(self):
        """Log current status"""
        logger.info("="*60)
        logger.info(f"🔐 Master Control v{self.version}")
        logger.info(f"📱 Current device: {self.current_device['name']} ({self.current_device['id'][:8]}...)")
        logger.info(f"📊 Devices registered: {len(self.trusted_devices)}")
        
        bio_count = len(self.biometric_data.get('master', {}))
        logger.info(f"🔑 Biometric factors: {bio_count}/5")
        if bio_count < 5:
            logger.info("   Missing: " + ", ".join(self._missing_factors()))
        
        logger.info("="*60)
    
    def _missing_factors(self) -> List[str]:
        """List missing biometric factors"""
        all_factors = ['crypto', 'pattern', 'face', 'touchid', 'voice']
        enrolled = self.biometric_data.get('master', {}).keys()
        return [f for f in all_factors if f not in enrolled]
    
    # ======================================================================
    # STATUS METHODS
    # ======================================================================
    
    def get_status(self) -> Dict[str, Any]:
        """Get current component status"""
        return {
            'component': self.component_id,
            'name': self.name,
            'version': self.version,
            'status': self.status,
            'current_device': {
                'name': self.current_device['name'],
                'id': self.current_device['id'][:8] + '...',
                'trust': self._get_device(self.current_device['id']).get('trust_level', 'unknown')
            },
            'biometrics': {
                'enrolled': len(self.biometric_data.get('master', {})),
                'missing': self._missing_factors()
            },
            'devices': {
                'registered': len(self.trusted_devices),
                'trusted': sum(1 for d in self.trusted_devices.values() 
                              if d.get('trust_level') in ['high', 'master'])
            },
            'auth_state': {
                'level': self.auth_state['level'],
                'authenticated': self.auth_state['master_token'] is not None,
                'session_valid': self._verify_session(self.auth_state['master_token']) if self.auth_state['master_token'] else False
            },
            'stats': self.stats,
            'methods': ['run', 'evolve', 'execute', 'process', 'generate', 'query']
        }
    
    def info(self) -> Dict[str, Any]:
        """Get component information"""
        return {
            'name': self.name,
            'id': self.component_id,
            'version': self.version,
            'status': self.status,
            'depends_on': self.depends_on,
            'auth_levels': [l.value for l in AuthLevel],
            'device_levels': [l.value for l in DeviceTrustLevel],
            'biometrics_enrolled': list(self.biometric_data.get('master', {}).keys()),
            'devices_trusted': len(self.trusted_devices),
            'methods': ['run', 'evolve', 'execute', 'process', 'generate', 'query']
        }
    
    # Required DMAI methods
    def run(self, continuous=False, interval=60):
        """Main execution method"""
        logger.info(f"🚀 Starting {self.name} v{self.version}")
        if continuous:
            while True:
                self._log_status()
                time.sleep(interval)
        return self.get_status()
    
    def evolve(self):
        """Evolution method"""
        self.version = f"3.1.{len(self.auth_sessions) + 1}"
        return {
            'component': self.component_id,
            'evolution': 'completed',
            'new_version': self.version,
            'stats': self.stats
        }
    
    def execute(self, command=None, **kwargs):
        """Execute method"""
        if command == 'authenticate':
            return self.authenticate(kwargs.get('context', {}))
        elif command == 'quick':
            return self.quick_auth(kwargs.get('action', 'view'))
        elif command == 'register':
            return self.register_device(kwargs.get('name'), kwargs.get('trust', 'medium'))
        elif command == 'enroll_touchid':
            return self.enroll_touchid()
        elif command == 'status':
            return self.get_status()
        else:
            return self.execute_command(command, kwargs.get('auth_token'), kwargs.get('params'))
    
    def process(self, data=None):
        """Process method"""
        if data and isinstance(data, dict):
            results = {}
            if 'authentications' in data:
                results['auth'] = [self.authenticate(ctx) for ctx in data['authentications']]
            if 'commands' in data:
                results['commands'] = [self.execute_command(cmd['command'], cmd.get('token'), cmd.get('params')) 
                                      for cmd in data['commands']]
            return results
        return {'processed': True}
    
    def generate(self):
        """Generate method"""
        return self.get_status()
    
    def query(self, question=None):
        """Query method"""
        if question == 'health':
            return {
                'healthy': True,
                'authenticated': self.auth_state['master_token'] is not None,
                'device': self.current_device['name']
            }
        return self.info()


# ======================================================================
# ENROLLMENT SCRIPT - WITH TOUCHID SUPPORT
# ======================================================================

def enroll_interactive():
    """Interactive enrollment wizard with TouchID support"""
    print("\n" + "="*70)
    print("🔐 DMAI MASTER CONTROL ENROLLMENT")
    print("="*70)
    print("\nThis will set up YOUR authentication factors.")
    print("You can do this in any order and add more later.\n")
    
    mc = MasterControl()
    
    # Show current status
    current = mc.biometric_data.get('master', {})
    if current:
        print(f"Already enrolled: {', '.join(current.keys())}")
        print("\nYou can add more factors or re-enroll existing ones.")
    
    print("\n📝 Available factors to enroll:")
    print("   1. Cryptographic Key (required)")
    print("   2. Secret Pattern (required)")
    print("   3. Face Recognition (using camera)")
    if platform.system() == "Darwin":
        print("   4. TouchID (fingerprint) - RECOMMENDED for Mac")
    else:
        print("   4. Fingerprint Simulation (PIN)")
    print("   5. Voice Recognition (optional - quiet environment recommended)")
    
    # Enroll crypto key
    if 'crypto' not in current:
        print("\n🔑 STEP 1: Cryptographic Key")
        print("Enter a strong key (or use one of your backup codes):")
        key = input("> ").strip()
        while len(key) < 16:
            print("❌ Key too short. Minimum 16 characters:")
            key = input("> ").strip()
        
        # Store crypto key
        crypto_entry = {
            'type': 'crypto',
            'enrolled_at': datetime.now().isoformat(),
            'hash': hashlib.sha512(key.encode()).hexdigest()
        }
        if 'master' not in mc.biometric_data:
            mc.biometric_data['master'] = {}
        mc.biometric_data['master']['crypto'] = crypto_entry
        mc._save_json('biometrics.json', mc.biometric_data)
        print("✅ Cryptographic key enrolled")
    
    # Enroll pattern
    if 'pattern' not in current:
        print("\n🎯 STEP 2: Secret Pattern")
        print("Enter a memorable pattern (phrase, numbers, or combination):")
        pattern = input("> ").strip()
        while len(pattern) < 8:
            print("❌ Pattern too short. Minimum 8 characters:")
            pattern = input("> ").strip()
        
        pattern_entry = {
            'type': 'pattern',
            'enrolled_at': datetime.now().isoformat(),
            'hash': hashlib.sha512(pattern.encode()).hexdigest()
        }
        mc.biometric_data['master']['pattern'] = pattern_entry
        mc._save_json('biometrics.json', mc.biometric_data)
        print("✅ Secret pattern enrolled")
    
    # Enroll face
    if 'face' not in current:
        print("\n📸 STEP 3: Face Recognition")
        print("This will use your camera to capture facial features.")
        print("Press Enter when ready (camera will activate)...")
        input()
        
        # Simulate face capture
        face_data = {
            'timestamp': time.time(),
            'features': [1.0] * 128,  # Simplified feature vector
            'confidence': 1.0
        }
        face_entry = {
            'type': 'face',
            'enrolled_at': datetime.now().isoformat(),
            'data': mc._hash_biometric(face_data)
        }
        mc.biometric_data['master']['face'] = face_entry
        mc._save_json('biometrics.json', mc.biometric_data)
        print("✅ Face recognition enrolled")
    
    # Enroll fingerprint (TouchID for Mac, PIN for others)
    if 'touchid' not in current and 'fingerprint_pin' not in current:
        print("\n🖐️ STEP 4: Fingerprint Authentication")
        
        if platform.system() == "Darwin":
            print("We detected you're on a Mac with TouchID!")
            print("Would you like to use TouchID? (y/n):")
            use_touchid = input("> ").lower()
            
            if use_touchid == 'y':
                result = mc.enroll_touchid()
                print(result['message'])
            else:
                print("Enter a 4-8 digit PIN as fallback:")
                pin = input("> ").strip()
                while not pin.isdigit() or len(pin) < 4:
                    print("❌ Please enter 4-8 digits:")
                    pin = input("> ").strip()
                
                pin_entry = {
                    'type': 'fingerprint_pin',
                    'enrolled_at': datetime.now().isoformat(),
                    'hash': hashlib.sha256(pin.encode()).hexdigest()
                }
                mc.biometric_data['master']['fingerprint_pin'] = pin_entry
                mc._save_json('biometrics.json', mc.biometric_data)
                print("✅ PIN fallback enrolled")
        else:
            print("Enter a 4-8 digit PIN for fingerprint simulation:")
            pin = input("> ").strip()
            while not pin.isdigit() or len(pin) < 4:
                print("❌ Please enter 4-8 digits:")
                pin = input("> ").strip()
            
            pin_entry = {
                'type': 'fingerprint_pin',
                'enrolled_at': datetime.now().isoformat(),
                'hash': hashlib.sha256(pin.encode()).hexdigest()
            }
            mc.biometric_data['master']['fingerprint_pin'] = pin_entry
            mc._save_json('biometrics.json', mc.biometric_data)
            print("✅ Fingerprint simulation enrolled")
    
    # Voice enrollment note
    if 'voice' not in current:
        print("\n🎤 STEP 5: Voice Recognition")
        print("Note: You're in an office environment.")
        print("You can enroll voice later in a quiet space with:")
        print("   python3 -c 'from components.phase1.P1T9_Implement_master_control import enroll_voice; enroll_voice()'")
    
    # Register current device
    print("\n📱 Registering this device...")
    mc.register_device(platform.node(), 'master')
    
    print("\n" + "="*70)
    print("✅ ENROLLMENT COMPLETE!")
    print("="*70)
    print("\nYour master control is now configured with:")
    enrolled = list(mc.biometric_data.get('master', {}).keys())
    for factor in enrolled:
        print(f"   • {factor}")
    print("\nTo verify your access:")
    print("   python3 -c 'from components.phase1.P1T9_Implement_master_control import verify_access; verify_access()'")
    print("="*70)

def verify_access():
    """Verify master access"""
    mc = MasterControl()
    
    print("\n" + "="*70)
    print("🔐 VERIFY MASTER ACCESS")
    print("="*70)
    
    factors = {}
    
    # Get crypto key
    print("\nEnter your cryptographic key:")
    factors['crypto_key'] = input("> ").strip()
    
    # Get pattern
    print("\nEnter your secret pattern:")
    factors['pattern'] = input("> ").strip()
    
    # Get face (simulated)
    print("\nLook at the camera for face recognition")
    print("Press Enter when ready...")
    input()
    factors['face'] = {'capture': True, 'timestamp': time.time()}
    
    # Check if TouchID is available
    if platform.system() == "Darwin" and 'touchid' in mc.biometric_data.get('master', {}):
        print("\n🖐️ Using TouchID for fingerprint...")
        factors['use_touchid'] = True
    else:
        print("\nEnter your fingerprint PIN:")
        factors['fingerprint'] = input("> ").strip()
    
    # Verify
    result = mc.verify_master_access(factors)
    
    print("\n" + "="*70)
    if result['status'] == 'authenticated':
        print("✅✅✅ MASTER ACCESS GRANTED!")
        print(f"Verified factors: {', '.join(result['verified_factors'])}")
        print(f"Token: {result['master_token'][:16]}...")
        print(f"Expires: {result['expires_at']}")
    else:
        print("❌❌❌ ACCESS DENIED")
        print(f"Verified: {result.get('verified_factors', [])}")
        print(f"Failed attempts: {result.get('failed_attempts', 0)}/5")
    print("="*70)

def enroll_voice():
    """Separate voice enrollment for quiet environments"""
    mc = MasterControl()
    
    print("\n" + "="*70)
    print("🎤 VOICE RECOGNITION ENROLLMENT")
    print("="*70)
    print("\nFind a quiet space for best results.")
    print("You'll be asked to speak a phrase 3 times.\n")
    
    # Collect voice samples
    samples = []
    phrases = [
        "DMAI master access",
        "my voice is my password",
        "authenticate master control"
    ]
    
    for i, phrase in enumerate(phrases):
        print(f"\nSample {i+1}/3 - Speak: '{phrase}'")
        print("Press Enter when ready to speak...")
        input()
        
        # Simulate voice capture
        sample = {
            'phrase': phrase,
            'timestamp': time.time(),
            'features': [0.5] * 64,  # Simplified voice features
            'quality': 'good'
        }
        samples.append(sample)
    
    voice_data = {
        'samples': samples,
        'enrolled_at': time.time(),
        'model': 'voice_model_v1'
    }
    
    voice_entry = {
        'type': 'voice',
        'enrolled_at': datetime.now().isoformat(),
        'data': mc._hash_biometric(voice_data)
    }
    
    if 'master' not in mc.biometric_data:
        mc.biometric_data['master'] = {}
    mc.biometric_data['master']['voice'] = voice_entry
    mc._save_json('biometrics.json', mc.biometric_data)
    
    print("\n✅ Voice recognition enrolled!")


if __name__ == "__main__":
    import argparse
    parser = argparse.ArgumentParser(description='Master Control - Adaptive Authentication')
    parser.add_argument('--enroll', action='store_true', help='Run interactive enrollment')
    parser.add_argument('--verify', action='store_true', help='Verify master access')
    parser.add_argument('--enroll-voice', action='store_true', help='Enroll voice separately')
    parser.add_argument('--enroll-touchid', action='store_true', help='Enroll TouchID separately')
    parser.add_argument('--status', action='store_true', help='Show status')
    parser.add_argument('--devices', action='store_true', help='List trusted devices')
    
    args = parser.parse_args()
    
    if args.enroll:
        enroll_interactive()
    elif args.verify:
        verify_access()
    elif args.enroll_voice:
        enroll_voice()
    elif args.enroll_touchid:
        mc = MasterControl()
        result = mc.enroll_touchid()
        print(json.dumps(result, indent=2))
    elif args.devices:
        mc = MasterControl()
        print("\n📱 Trusted Devices:")
        for device in mc.trusted_devices.values():
            print(f"   {device['name']}: {device.get('trust_level', 'unknown')} trust (auths: {device.get('auth_count', 0)})")
    elif args.status:
        mc = MasterControl()
        print(json.dumps(mc.get_status(), indent=2))
    else:
        print("\n🔐 MASTER CONTROL - Adaptive Authentication")
        print("="*60)
        print("Commands:")
        print("  --enroll         Run interactive enrollment")
        print("  --verify         Verify master access")
        print("  --enroll-voice   Enroll voice separately")
        print("  --enroll-touchid Enroll TouchID separately")
        print("  --devices        List trusted devices")
        print("  --status         Show status")
        print("="*60)
