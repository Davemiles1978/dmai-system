#!/bin/bash
cd ~/Desktop/AI-Evolution-System
source venv/bin/activate

# Get evolution stats for version number
VERSION_INFO=$(python3 -c "
import json
from pathlib import Path

history_file = Path('checkpoints/evolution_history.json')
if history_file.exists():
    with open(history_file) as f:
        history = json.load(f)
    
    if history:
        latest = history[-1]
        generation = latest.get('generation', 0)
        score = latest.get('score', 0.5)
        
        # Format score as nice number (0.94 -> 94)
        score_int = int(score * 100)
        
        # Make generation number readable
        if generation >= 10000:
            gen_display = f'{generation/1000:.1f}k'
        elif generation >= 1000:
            gen_display = f'{generation/1000:.1f}k'
        else:
            gen_display = str(generation)
        
        print(f'v{gen_display}.{score_int}')
    else:
        print('v1.0')
else:
    print('v1.0')
")

# Check if cloud or local
if [ -f ~/Desktop/AI_EVOLUTION_URL.txt ]; then
    CLOUD_URL=$(cat ~/Desktop/AI_EVOLUTION_URL.txt)
    open "$CLOUD_URL"
else
    # Start local server
    python3 -m http.server 8888 --bind 0.0.0.0 &
    SERVER_PID=$!
    
    sleep 2
    open "http://localhost:8888/ai_ui.html?version=$VERSION_INFO"
    
    wait $SERVER_PID
fi
