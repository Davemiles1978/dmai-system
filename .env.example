# DMAI Environment Variables Template
# Copy to .env and fill in real values

# Security
MASTER_PASSWORD=your_master_password
FLASK_SECRET_KEY=your_secret_key_here

# Database
DATABASE_URL=postgresql://user:pass@localhost:5432/dmai
USE_POSTGRESQL=false

# AI Tutor API Keys
OPENAI_API_KEY=sk-...
DEEPSEEK_API_KEY=ds-...
GEMINI_API_KEY=AIza...
ANTHROPIC_API_KEY=sk-ant-...
PERPLEXITY_API_KEY=pplx-...

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# GitHub Tokens
GITHUB_TOKEN_MAIN=github_pat_...
GITHUB_TOKEN_SECONDARY=github_pat_...
GITHUB_REPOS_TO_MONITOR=org/repo1,org/repo2
GITHUB_SEARCH_QUERIES=ai,ml,llm

# Wallets
DMAI_OPS_WALLET=0x...
MASTER_WALLET=0x...

# Neo4j Knowledge Graph (Required)
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password

# Media & Voice
ELEVENLABS_API_KEY=your_key
SPOTIFY_CLIENT_ID=your_id
SPOTIFY_CLIENT_SECRET=your_secret
TOR_PROXY=socks5://127.0.0.1:9050
