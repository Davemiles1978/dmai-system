# ====================================================================
# DMAI v2.0 environment configuration
# Copy to .env and fill in the values you need. All have safe defaults.
# ====================================================================

# ---- Core ----
DMAI_ENV=development            # development | sandbox | production
MASTER_KEY=DMAI_MASTER_2026     # operator master key (operator-only routes)
API_SECRET_KEY=change-me        # API key for /api/v1 routes (X-API-Key header)

# ---- Database ----
# Primary: Postgres. Falls back to SQLite when unset / sqlite URL given.
DATABASE_URL=sqlite:///data/dmai.db
# DATABASE_URL=postgresql://dmai:dmai_dev@postgres:5432/dmai
REDIS_URL=redis://localhost:6379
POSTGRES_PASSWORD=dmai_dev

# ---- AI APIs ----
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=

# ---- Trading (Alpaca) ----
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ---- Telegram notifications ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Self-funding ----
SELF_FUNDING_MODE=paper         # paper | real | autonomous
SPEND_LIMIT_DAILY=50.0

# ---- Ports ----
API_PORT=8000
FLASK_PORT=5001
