#!/usr/bin/env python3
"""
DMAI Web Interface - Flask application for DMAI chat and admin interface
UNAUTHENTICATED VERSION - Login bypassed for testing
"""

import os
import sys
import logging
import json
from datetime import datetime, timedelta

# Try to import Flask
try:
    from flask import Flask, render_template, request, jsonify, session, redirect, url_for, send_from_directory
    from flask_cors import CORS
except ImportError:
    print("❌ Flask not installed. Run: pip install flask flask-cors")
    sys.exit(1)

# Configure logging
logging.basicConfig(
    level=logging.INFO,
    format='%(asctime)s - 🧠 DMAI[%(name)s] - %(levelname)s - %(message)s',
    handlers=[
        logging.FileHandler('web.log'),
        logging.StreamHandler()
    ]
)
logger = logging.getLogger('web')

# Initialize Flask app
app = Flask(__name__)
app.secret_key = os.environ.get('SECRET_KEY', 'dev-secret-key-change-in-production')
app.config['SESSION_COOKIE_NAME'] = 'session'
app.config['SESSION_COOKIE_HTTPONLY'] = True
app.config['SESSION_COOKIE_SAMESITE'] = 'Lax'
app.config['PERMANENT_SESSION_LIFETIME'] = timedelta(days=7)
app.config['SESSION_REFRESH_EACH_REQUEST'] = True

# Enable CORS
CORS(app, supports_credentials=True)

# Try to import DMAI Core
try:
    sys.path.append(os.path.dirname(os.path.abspath(__file__)))
    from dmai_core_clean import DMAIIntelligence
    core = DMAIIntelligence()
    logger.info("✅ DMAI Core loaded successfully")
except ImportError as e:
    logger.error(f"❌ Failed to load DMAI Core: {e}")
    core = None
except Exception as e:
    logger.error(f"❌ Error initializing DMAI Core: {e}")
    core = None

# ============================================
# BYPASS AUTHENTICATION - ALWAYS LOGGED IN
# ============================================
@app.before_request
def force_authentication():
    """Bypass authentication - always set authenticated session"""
    session['authenticated'] = True
    session['username'] = 'David'

# ============================================
# ROUTES - PUBLIC
# ============================================

@app.route('/')
def index():
    """Main chat interface - no login required"""
    # Get generation from core if available
    generation = 0
    try:
        if core and hasattr(core, 'generation'):
            generation = core.generation
        elif core and hasattr(core, 'get_status'):
            status = core.get_status()
            generation = status.get('generation', 0)
    except Exception as e:
        logger.error(f"Error getting generation: {e}")
    
    return render_template('chat.html', 
                         generation=generation,
                         user='David')

@app.route('/login')
def login_page():
    """Login page - redirects directly to chat"""
    return redirect(url_for('index'))

@app.route('/vision')
def vision():
    """DMAI Vision document"""
    return render_template('vision.html')

@app.route('/health')
def health():
    """Health check endpoint"""
    return jsonify({
        'status': 'healthy',
        'core': core is not None,
        'authenticated': True
    })

@app.route('/debug/session')
def debug_session():
    """Debug endpoint to check session"""
    return jsonify({
        'authenticated': session.get('authenticated', False),
        'username': session.get('username'),
        'session_keys': list(session.keys()),
        'cookie_present': 'session' in request.cookies
    })

# ============================================
# ROUTES - ADMIN (no auth required now)
# ============================================

@app.route('/admin')
def admin():
    """Admin dashboard"""
    return render_template('admin.html', user='David')

@app.route('/api/status')
def api_status():
    """Get system status"""
    if core:
        try:
            if hasattr(core, 'get_status'):
                status = core.get_status()
            else:
                # Fallback status
                status = {
                    'generation': getattr(core, 'generation', 0),
                    'components': {
                        'total': 52,
                        'healthy': 13,
                        'needs_evolution': 39,
                        'by_phase': {
                            'phase0': 5,
                            'phase1': 10,
                            'phase2': 6,
                            'phase3': 7,
                            'phase4': 5,
                            'phase5': 7,
                            'phase6': 6,
                            'phase7': 6
                        },
                        'evolution_queue_size': 39
                    },
                    'metrics': {
                        'evolutions': getattr(core, 'evolution_count', 0),
                        'thoughts_processed': getattr(core, 'thoughts_count', 0),
                        'learnings': getattr(core, 'learnings_count', 0),
                        'funding_generated': getattr(core, 'funding_generated', 0.0)
                    },
                    'tools': {
                        'available': 1
                    },
                    'uptime': 'Unknown'
                }
            
            # Add authentication info
            status['authenticated'] = True
            status['user'] = 'David'
            
            return jsonify(status)
        except Exception as e:
            logger.error(f"Error getting status: {e}")
            return jsonify({'error': str(e)}), 500
    else:
        return jsonify({'error': 'Core not initialized'}), 503

@app.route('/api/evolution/queue')
def api_evolution_queue():
    """Get evolution queue"""
    if core and hasattr(core, 'get_evolution_queue'):
        try:
            queue = core.get_evolution_queue()
            return jsonify(queue)
        except Exception as e:
            logger.error(f"Error getting evolution queue: {e}")
            return jsonify({'error': str(e)}), 500
    else:
        # Return mock data for testing
        return jsonify({
            'queue_size': 39,
            'needs_evolution': [
                {'id': 'P0T0_Migrate_Database_to_Production', 'health_score': 16, 'missing_methods': ['evolve', 'execute', 'process', 'generate', 'query']},
                {'id': 'P1T10_Test_fragment_recreation', 'health_score': 0, 'missing_methods': ['run', 'evolve', 'execute', 'process', 'generate', 'query']}
            ]
        })

@app.route('/api/keys')
def api_keys():
    """Get API keys summary"""
    return jsonify({
        'total': 2,
        'by_service': {
            'telegram': {'count': 1, 'active': True},
            'github': {'count': 1, 'active': True}
        }
    })

@app.route('/api/command', methods=['POST'])
def api_command():
    """Execute admin commands"""
    data = request.json
    command = data.get('command')
    
    if command == 'evolve':
        if core and hasattr(core, 'evolve'):
            try:
                result = core.evolve()
                return jsonify({'success': True, 'message': 'Evolution triggered', 'result': result})
            except Exception as e:
                return jsonify({'success': False, 'error': str(e)}), 500
        else:
            return jsonify({'success': False, 'error': 'Evolution not available'}), 400
    
    elif command == 'health_audit':
        if core and hasattr(core, 'health_audit'):
            try:
                result = core.health_audit()
                return jsonify({'success': True, 'message': 'Health audit completed', 'result': result})
            except Exception as e:
                return jsonify({'success': False, 'error': str(e)}), 500
        else:
            return jsonify({'success': False, 'error': 'Health audit not available'}), 400
    
    else:
        return jsonify({'success': False, 'error': f'Unknown command: {command}'}), 400

# ============================================
# ROUTES - CHAT API
# ============================================

@app.route('/api/chat', methods=['POST'])
def api_chat():
    """Chat endpoint - no authentication required now"""
    data = request.json
    message = data.get('message', '')
    
    if not message:
        return jsonify({'error': 'Message is required'}), 400
    
    # Process message through core
    if core:
        try:
            if hasattr(core, 'process_message'):
                response = core.process_message(message)
            elif hasattr(core, 'chat'):
                response = core.chat(message)
            else:
                # Fallback response
                response = f"Echo: {message}\n\n[Core processing not available]"
            
            # Get current generation
            generation = 0
            if hasattr(core, 'generation'):
                generation = core.generation
            elif hasattr(core, 'get_status'):
                status = core.get_status()
                generation = status.get('generation', 0)
            
            return jsonify({
                'response': response,
                'generation': generation,
                'timestamp': str(datetime.now())
            })
        except Exception as e:
            logger.error(f"Error processing message: {e}")
            return jsonify({'error': str(e)}), 500
    else:
        return jsonify({'error': 'Core not available'}), 503

# ============================================
# ROUTES - AUTHENTICATION (disabled)
# ============================================

@app.route('/api/auth', methods=['POST'])
def api_auth():
    """Authentication endpoint - always succeeds"""
    data = request.json
    username = data.get('username', 'David')
    
    # Always authenticate successfully
    session['authenticated'] = True
    session['username'] = username
    session.permanent = True
    logger.info(f"✅ Auto-login for user '{username}'")
    return jsonify({'success': True, 'redirect': '/'})

@app.route('/api/logout', methods=['POST'])
def api_logout():
    """Logout endpoint - clears session"""
    session.clear()
    return jsonify({'success': True})

# ============================================
# ROUTES - STATIC FILES
# ============================================

@app.route('/static/<path:filename>')
def static_files(filename):
    """Serve static files"""
    return send_from_directory('static', filename)

# ============================================
# ERROR HANDLERS
# ============================================

@app.errorhandler(404)
def not_found(error):
    """404 error handler"""
    return render_template('404.html'), 404

@app.errorhandler(500)
def internal_error(error):
    """500 error handler"""
    logger.error(f"Internal server error: {error}")
    return render_template('500.html'), 500

# ============================================
# MAIN ENTRY POINT
# ============================================

if __name__ == '__main__':
    from datetime import timedelta
    
    # Get port from environment or use default
    port = int(os.environ.get('PORT', 5001))
    
    # In production, don't use debug mode
    debug = os.environ.get('FLASK_ENV') != 'production'
    
    logger.info(f"🚀 Starting DMAI Web Interface on port {port}")
    logger.info(f"🔓 AUTHENTICATION BYPASSED - Auto-login enabled")
    logger.info(f"🧠 Core status: {'Loaded' if core else 'Not loaded'}")
    
    # Run the app
    app.run(
        host='0.0.0.0',
        port=port,
        debug=debug,
        threaded=True
    )
