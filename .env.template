# ============================================================
# DMAI – Environment Variables Template
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ============================================================

# ------------------------------------------------------------
# Core System
# ------------------------------------------------------------
PORT=10000                          # Port the server listens on
MASTER_PASSWORD=your_value_here     # Master admin password for DMAI
DATA_PATH=data/                     # Local path for persistent data files
RENDER=false                        # Set to "true" when running on Render
LOG_LEVEL=INFO                      # Logging verbosity: DEBUG | INFO | WARNING | ERROR

# ------------------------------------------------------------
# Database
# ------------------------------------------------------------
DATABASE_URL=your_value_here        # PostgreSQL connection string (e.g. postgresql://user:pass@host:5432/db)

# ------------------------------------------------------------
# Telegram
# ------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your_value_here  # Bot token from @BotFather
TELEGRAM_CHAT_ID=your_value_here    # Chat/channel ID to send notifications to

# ------------------------------------------------------------
# AI Providers — Existing
# ------------------------------------------------------------
OPENAI_API_KEY=your_value_here              # OpenAI API key (GPT-4, Whisper, DALL-E, etc.)
DEEPSEEK_API_KEY=your_value_here            # DeepSeek API key
GEMINI_API_KEY=your_value_here              # Google Gemini API key
ANTHROPIC_API_KEY=your_value_here           # Anthropic Claude API key
PERPLEXITY_API_KEY=your_value_here          # Perplexity AI API key
XAI_API_KEY=your_value_here                 # xAI (Grok) API key
HUGGINGFACE_API_KEY=your_value_here         # Hugging Face Inference API key
GOOGLE_AI_STUDIO_KEY=your_value_here        # Google AI Studio API key
NOTEBOOKLM_API_KEY=your_value_here          # NotebookLM API key
IMAGEN_API_KEY=your_value_here              # Google Imagen image-generation API key
GEMINI_GEMS_KEY=your_value_here             # Gemini Gems (custom Gems) API key

# ------------------------------------------------------------
# AI Providers — New Extended Hub
# ------------------------------------------------------------
MISTRAL_API_KEY=your_value_here             # Mistral AI API key
STABILITY_API_KEY=your_value_here           # Stability AI (Stable Diffusion) API key
ELEVENLABS_API_KEY=your_value_here          # ElevenLabs text-to-speech API key
RUNWAY_API_KEY=your_value_here              # Runway ML video-generation API key
REPLICATE_API_KEY=your_value_here           # Replicate model-hosting API key
PINECONE_API_KEY=your_value_here            # Pinecone vector database API key
TOGETHER_API_KEY=your_value_here            # Together AI inference API key
COHERE_API_KEY=your_value_here              # Cohere NLP API key

# ------------------------------------------------------------
# GitHub
# ------------------------------------------------------------
GITHUB_TOKEN_MAIN=your_value_here           # Primary GitHub personal access token
GITHUB_TOKEN_SECONDARY=your_value_here      # Secondary / fallback GitHub personal access token

# ------------------------------------------------------------
# Vector DB (Pinecone)
# ------------------------------------------------------------
PINECONE_INDEX=your_value_here              # Name of the Pinecone index to use
PINECONE_ENVIRONMENT=your_value_here        # Pinecone environment (e.g. us-east-1-aws)

# ------------------------------------------------------------
# Trading (Alpaca)
# ------------------------------------------------------------
ALPACA_API_KEY=your_value_here              # Alpaca Markets API key
ALPACA_SECRET_KEY=your_value_here           # Alpaca Markets secret key
ALPACA_BASE_URL=https://paper-api.alpaca.markets  # Alpaca endpoint (paper or live)

# ------------------------------------------------------------
# AWS
# ------------------------------------------------------------
AWS_ACCESS_KEY_ID=your_value_here           # AWS IAM access key ID
AWS_SECRET_ACCESS_KEY=your_value_here       # AWS IAM secret access key
AWS_REGION=us-east-1                        # Default AWS region

# ------------------------------------------------------------
# Content / Publishing
# ------------------------------------------------------------
KDP_EMAIL=your_value_here                   # Amazon KDP account email
KDP_PASSWORD=your_value_here                # Amazon KDP account password
AMAZON_SELLER_ID=your_value_here            # Amazon Seller Central merchant ID
